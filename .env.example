# ── Environment ──────────────────────────────────────────────
NODE_ENV=development          # development | production

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────
DB_CLIENT=sqlite              # sqlite | postgres
SQLITE_PATH=./db/viaara.sqlite

# PostgreSQL (used when DB_CLIENT=postgres, i.e. on EC2)
PG_HOST=localhost
PG_PORT=5432
PG_USER=viaara
PG_PASSWORD=your_password
PG_DATABASE=viaara_db

# ── Storage ──────────────────────────────────────────────────
STORAGE=local                 # local | s3

# Local storage path (relative to project root)
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (used when STORAGE=s3, i.e. on EC2)
AWS_REGION=ap-south-1
S3_BUCKET=viaara-travel-images-807593376390-ap-south-1-an
CLOUDFRONT_URL=https://dtftq47mw2hqk.cloudfront.net

# Local development only, if using AWS CLI profile
# AWS_PROFILE=viaara-local

# ── Admin ────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required: at least 32 characters
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
