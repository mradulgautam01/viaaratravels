# ── Environment ──────────────────────────────────────────────
NODE_ENV=development          # development | production

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────
DB_CLIENT=sqlite              # sqlite | postgres
SQLITE_PATH=./db/viaara.sqlite

# PostgreSQL (used when DB_CLIENT=postgres, i.e. on EC2)
PG_HOST=localhost
PG_PORT=5432
PG_USER=viaara
PG_PASSWORD=your_password
PG_DATABASE=viaara_db

# ── Storage ──────────────────────────────────────────────────
STORAGE=local                 # local | s3

# Local storage path (relative to project root)
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (used when STORAGE=s3, i.e. on EC2)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
S3_BUCKET=viaara-media

# ── Admin ────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=change_this_to_a_long_random_secret_string
